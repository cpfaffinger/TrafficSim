{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TrafficSim": ""
  },
  "Providers": {
    "Contact": "https://github.com/cpfaffinger/TrafficSim",
    "Photon": {
      "Enabled": true,
      "BaseUrl": "https://photon.komoot.io/",
      "Priority": 10,
      "Timeout": "00:00:10"
    },
    "Nominatim": { "Enabled": true, "Priority": 20, "RequestsPerSecond": 1 },
    "Overpass": { "Enabled": true, "MaxAreaSquareKilometers": 50 },
    "Geofabrik": { "Enabled": true, "MaxAreaSquareKilometers": 2500 },
    "Google": { "Enabled": false }
  }
}
