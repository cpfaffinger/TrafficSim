# Copy to .env and adjust. Never commit .env (C-05).

# Database (required)
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trafficsim
POSTGRES_USER=trafficsim

# Published HTTP port of the app container; bind to 127.0.0.1 behind a reverse proxy (C-42)
TRAFFICSIM_BIND=127.0.0.1
TRAFFICSIM_HTTP_PORT=8080

# Contact sent in the User-Agent to community services (C-17)
TRAFFICSIM_CONTACT=https://github.com/cpfaffinger/TrafficSim

# Providers
PHOTON_BASE_URL=https://photon.komoot.io/

# Build metadata (set by deploy scripts)
SOURCE_COMMIT=dev
TRAFFICSIM_IMAGE_TAG=local
ASPNETCORE_ENVIRONMENT=Production
